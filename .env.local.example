# ---------------------------------------------------------------------------
# MEDIX environment variables
# Copy this file to .env.local and fill in values as later steps wire up
# real services. Nothing in Step 1 reads these yet — they are placeholders
# so the project is ready for Supabase auth/data and future APIs.
# ---------------------------------------------------------------------------

# Supabase (auth + database) — added in a later step
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI symptom assessment provider — used by Step 3 (app/api/symptom-assessment)
# Without this set, the app runs in Demo Mode: the deterministic risk engine
# still classifies every case, but explanations come from local templates
# instead of a live model. See services/aiService.ts.
AI_PROVIDER_API_KEY=
# Optional overrides — defaults assume the Anthropic Messages API shape.
AI_PROVIDER_API_URL=
AI_PROVIDER_MODEL=

# Emergency / SOS services (hospitals, ambulance dispatch) — Step 4
# Hospital lookup defaults to the free OpenStreetMap Overpass API and needs
# no key. Set these only if you swap in a paid provider later — the UI
# (services/hospitalService.ts) doesn't need to change either way.
HOSPITAL_API_URL=
HOSPITAL_API_KEY=
MAP_PROVIDER_API_KEY=
AMBULANCE_API_KEY=
EMERGENCY_SERVICES_API_KEY=
