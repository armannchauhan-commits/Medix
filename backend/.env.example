# ---------------------------------------------------------------------------
# MEDIX BACKEND Environment Variables
# Copy to .env in the backend/ directory
# ---------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend URL (Used for generating emergency QR links & alert backlinks)
APP_URL=http://localhost:3000

# Twilio SMS Service (Optional - for real emergency SMS dispatch)
# If left empty, backend safely handles emergency alerts in demo mode without faking SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Hospital Search Service
HOSPITAL_API_URL=https://overpass-api.de/api/interpreter

# AI Provider for Symptom Assessment (Optional)
# If left empty, deterministic risk engine uses built-in clinical templates in demo mode
AI_PROVIDER_API_KEY=
AI_PROVIDER_API_URL=
AI_PROVIDER_MODEL=
