# ---------------------------------------------------------------------------
# MEDIX — AI Symptom Assessment (Step 3)
# Copy the value(s) you need into .env.local (see .env.local.example for the
# full list of every environment variable used across the app).
# ---------------------------------------------------------------------------

# Required for live AI explanations. Without it, Step 3 runs in Demo Mode —
# the deterministic risk engine (lib/risk-engine.ts) still classifies every
# case correctly, but explanations are generated locally instead of by a
# live model. Never exposed to the browser — only read server-side in
# app/api/symptom-assessment/route.ts via services/aiService.ts.
AI_PROVIDER_API_KEY=

# Optional — override if you're pointing at a different Messages-API-shaped
# provider or model. Defaults assume the Anthropic Messages API.
AI_PROVIDER_API_URL=https://api.anthropic.com/v1/messages
AI_PROVIDER_MODEL=claude-3-5-haiku-latest
